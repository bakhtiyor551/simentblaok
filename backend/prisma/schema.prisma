generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

model User {
  id             String          @id @default(cuid())
  login          String          @unique
  passwordHash   String
  roleId         String
  role           Role            @relation(fields: [roleId], references: [id])
  employee       Employee?
  isActive       Boolean         @default(true)
  lastLoginAt    DateTime?
  productions    Production[]
  orders         Order[]         @relation("OrderCreatedBy")
  deliveries     Delivery[]      @relation("DeliveryDriver")
  salaryAccruals Salary[]        @relation("SalaryCreatedBy")
  salaryPayments SalaryPayment[] @relation("PaymentCreatedBy")
  auditLogs      AuditLog[]
  notifications  Notification[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("users")
}

model Employee {
  id           String       @id @default(cuid())
  userId       String?      @unique
  user         User?        @relation(fields: [userId], references: [id])
  fullName     String
  phone        String?
  position     String?
  hireDate     DateTime     @default(now())
  isActive     Boolean      @default(true)
  ratePerBlock Decimal      @default(0)
  fixedSalary  Decimal      @default(0)
  calcType     String       @default("PER_BLOCK")
  productions  Production[]
  salaries     Salary[]
  fines        Fine[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("employees")
}

model Customer {
  id        String   @id @default(cuid())
  fullName  String
  phone     String
  address   String?
  notes     String?
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers")
}

model BlockType {
  id          String          @id @default(cuid())
  name        String          @unique
  code        String          @unique
  description String?
  unitPrice   Decimal         @default(0)
  minStock    Int             @default(100)
  isActive    Boolean         @default(true)
  stock       Stock?
  productions Production[]
  orderItems  OrderItem[]
  movements   StockMovement[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("block_types")
}

model Production {
  id          String    @id @default(cuid())
  blockTypeId String
  blockType   BlockType @relation(fields: [blockTypeId], references: [id])
  quantity    Int
  shift       String    @default("DAY")
  comment     String?
  employeeId  String?
  employee    Employee? @relation(fields: [employeeId], references: [id])
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  producedAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("production")
}

model Stock {
  id          String    @id @default(cuid())
  blockTypeId String    @unique
  blockType   BlockType @relation(fields: [blockTypeId], references: [id])
  quantity    Int       @default(0)
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  @@map("stock")
}

model StockMovement {
  id           String    @id @default(cuid())
  blockTypeId  String
  blockType    BlockType @relation(fields: [blockTypeId], references: [id])
  type         String
  quantity     Int
  balanceAfter Int
  reference    String?
  comment      String?
  createdById  String?
  createdAt    DateTime  @default(now())

  @@map("stock_movements")
}

model Order {
  id            String      @id @default(cuid())
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  status        String      @default("NEW")
  totalAmount   Decimal     @default(0)
  notes         String?
  needsDelivery Boolean     @default(false)
  createdById   String
  createdBy     User        @relation("OrderCreatedBy", fields: [createdById], references: [id])
  items         OrderItem[]
  delivery      Delivery?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("orders")
}

model OrderItem {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  blockTypeId String
  blockType   BlockType @relation(fields: [blockTypeId], references: [id])
  quantity    Int
  unitPrice   Decimal
  totalPrice  Decimal

  @@map("order_items")
}

model Vehicle {
  id          String     @id @default(cuid())
  plateNumber String     @unique
  model       String?
  capacity    Int?
  isActive    Boolean    @default(true)
  deliveries  Delivery[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("vehicles")
}

model Delivery {
  id          String    @id @default(cuid())
  orderId     String    @unique
  order       Order     @relation(fields: [orderId], references: [id])
  vehicleId   String?
  vehicle     Vehicle?  @relation(fields: [vehicleId], references: [id])
  driverId    String?
  driver      User?     @relation("DeliveryDriver", fields: [driverId], references: [id])
  status      String    @default("PENDING")
  address     String
  scheduledAt DateTime?
  deliveredAt DateTime?
  photoPath   String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("deliveries")
}

model Salary {
  id          String          @id @default(cuid())
  employeeId  String
  employee    Employee        @relation(fields: [employeeId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  blocksCount Int             @default(0)
  amount      Decimal
  finesAmount Decimal         @default(0)
  netAmount   Decimal
  comment     String?
  createdById String
  createdBy   User            @relation("SalaryCreatedBy", fields: [createdById], references: [id])
  payments    SalaryPayment[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("salary")
}

model SalaryPayment {
  id          String   @id @default(cuid())
  salaryId    String
  salary      Salary   @relation(fields: [salaryId], references: [id])
  amount      Decimal
  paidAt      DateTime @default(now())
  comment     String?
  createdById String
  createdBy   User     @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@map("salary_payments")
}

model Fine {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  amount     Decimal
  reason     String
  finedAt    DateTime @default(now())
  createdAt  DateTime @default(now())

  @@map("fines")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

model TelegramLog {
  id        String   @id @default(cuid())
  eventType String
  message   String
  success   Boolean
  response  String?
  createdAt DateTime @default(now())

  @@map("telegram_logs")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}
